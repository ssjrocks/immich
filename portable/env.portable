# Portable/offline env for the thumbdrive bundle. See docker-compose.portable.yml.
# Everything here stays local to the air-gapped machine — nothing is network-facing.

# Timezone (uncomment and set if you want local time in logs instead of UTC)
# TZ=Etc/UTC

# Change this if you like — it's only ever used locally between these containers.
DB_PASSWORD=postgres  # change this before the first start if you like
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
